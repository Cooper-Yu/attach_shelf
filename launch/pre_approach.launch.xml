<launch>
  <arg name="obstacle" default="0.4"/>
  <arg name="degrees" default="-90.0"/>
  <arg name="forward_speed" default="0.4"/>
  <arg name="angular_speed" default="0.5"/>
  <arg name="rotation_scale" default="0.5"/>
  <arg name="use_rviz" default="true"/>

  <include file="$(find-pkg-share attach_shelf)/launch/pre_approach.launch.py">
    <arg name="obstacle" value="$(var obstacle)"/>
    <arg name="degrees" value="$(var degrees)"/>
    <arg name="forward_speed" value="$(var forward_speed)"/>
    <arg name="angular_speed" value="$(var angular_speed)"/>
    <arg name="rotation_scale" value="$(var rotation_scale)"/>
    <arg name="use_rviz" value="$(var use_rviz)"/>
  </include>
</launch>
